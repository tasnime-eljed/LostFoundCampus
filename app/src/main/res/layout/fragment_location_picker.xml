<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_sand">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Repli -->
    <LinearLayout
        android:id="@+id/fallback"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/lf_cream"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/lf_space_xxl"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/lf_icon_lg"
            android:layout_height="@dimen/lf_icon_lg"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_map_off"
            app:tint="@color/lf_ink_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_md"
            android:text="@string/map_unavailable"
            android:textAppearance="@style/TextAppearance.LF.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_xs"
            android:gravity="center"
            android:text="@string/map_unavailable_body"
            android:textAppearance="@style/TextAppearance.LF.Body" />
    </LinearLayout>

    <!-- En-tête flottant -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/lf_space_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.LF.IconButton.Back" />

        <TextView
            android:id="@+id/txtInstructions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lf_space_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_map_label"
            android:padding="@dimen/lf_space_md"
            android:text="@string/picker_instructions"
            android:textAppearance="@style/TextAppearance.LF.BodySmall"
            android:textColor="@color/lf_ink_body" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/lf_space_xs"
        android:background="@drawable/bg_map_label"
        android:paddingStart="@dimen/lf_space_xs"
        android:paddingEnd="@dimen/lf_space_xs"
        android:text="@string/map_attribution"
        android:textAppearance="@style/TextAppearance.LF.Caption"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMyLocation"
        style="@style/Widget.LF.Button.Outlined.Soft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/lf_space_lg"
        android:text="@string/picker_my_location"
        app:icon="@drawable/ic_my_location"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panneau bas -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="@dimen/lf_screen_padding"
        android:paddingTop="@dimen/lf_space_sm"
        android:paddingEnd="@dimen/lf_screen_padding"
        android:paddingBottom="@dimen/lf_space_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            style="@style/Widget.LF.FieldLabel"
            android:labelFor="@id/etPrecision"
            android:text="@string/picker_precision_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPrecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrecision"
                style="@style/Widget.LF.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/picker_precision_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="80" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_lg"
            android:text="@string/picker_confirm" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
