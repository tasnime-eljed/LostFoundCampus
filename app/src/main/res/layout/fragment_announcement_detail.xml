<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_cream">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Galerie photos -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/lf_gallery_height"
                android:background="@color/lf_slate_200">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/txtBadge"
                    style="@style/Widget.LF.Badge.Lost"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/lf_space_lg"
                    tools:text="Perdu · Actif" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/dots"
                    style="@style/Widget.LF.DotsIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/lf_space_xxl"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/lf_space_md"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/lf_screen_padding"
                android:paddingTop="@dimen/lf_space_xl"
                android:paddingEnd="@dimen/lf_screen_padding"
                android:paddingBottom="@dimen/lf_space_xxl">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.LF.Headline"
                    tools:text="iPhone 13 noir" />

                <TextView
                    android:id="@+id/txtMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_space_xs"
                    android:textAppearance="@style/TextAppearance.LF.BodySmall"
                    tools:text="Publiée il y a 2 jours · Téléphones" />

                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_space_md"
                    android:textAppearance="@style/TextAppearance.LF.Body"
                    />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/lf_space_lg"
                        android:paddingEnd="@dimen/lf_space_lg">

                        <include
                            android:id="@+id/rowColor"
                            layout="@layout/view_info_row" />

                        <com.google.android.material.divider.MaterialDivider
                            style="@style/Widget.LF.Divider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/rowLocation"
                            layout="@layout/view_info_row" />

                        <com.google.android.material.divider.MaterialDivider
                            style="@style/Widget.LF.Divider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/rowDate"
                            layout="@layout/view_info_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_space_lg"
                    android:layout_marginBottom="@dimen/lf_space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detail_location_title"
                        android:textAppearance="@style/TextAppearance.LF.LabelStrong" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditLocation"
                        style="@style/Widget.LF.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_edit_location"
                        app:icon="@drawable/ic_edit" />
                </LinearLayout>

                <include
                    android:id="@+id/miniMap"
                    layout="@layout/view_mini_map" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/lf_space_lg">

                        <TextView
                            android:id="@+id/txtAuthorAvatar"
                            style="@style/Widget.LF.Avatar"
                            android:layout_width="@dimen/lf_avatar_md"
                            android:layout_height="@dimen/lf_avatar_md" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lf_space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAuthorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.LF.TitleMedium" />

                            <TextView
                                android:id="@+id/txtAuthorSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.LF.BodySmall" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.LF.IconButton.BackOnPhoto"
        android:layout_margin="@dimen/lf_space_lg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="@dimen/lf_screen_padding"
        android:paddingTop="@dimen/lf_space_md"
        android:paddingEnd="@dimen/lf_screen_padding"
        android:paddingBottom="@dimen/lf_space_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_contact" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMatches"
            style="@style/Widget.LF.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_sm"
            android:text="@string/detail_matches" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
