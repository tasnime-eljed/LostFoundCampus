<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lf_screen_padding"
        android:paddingTop="@dimen/lf_space_lg"
        android:paddingEnd="@dimen/lf_screen_padding"
        android:paddingBottom="@dimen/lf_space_xxl">

        <include
            android:id="@+id/header"
            layout="@layout/layout_screen_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_lg"
            android:text="@string/matches_intro"
            android:textAppearance="@style/TextAppearance.LF.BodySmall" />

        <!-- Rappel de l'annonce -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_lg"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/lf_space_lg">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgMine"
                    android:layout_width="@dimen/lf_thumb_card"
                    android:layout_height="@dimen/lf_thumb_card"
                    android:background="@color/lf_slate_200"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.LF.Medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lf_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtMineLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LF.LabelStrong"
                        android:textColor="@color/lf_pink_ink" />

                    <TextView
                        android:id="@+id/txtMineTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lf_space_xxs"
                        android:textAppearance="@style/TextAppearance.LF.TitleMedium" />

                    <TextView
                        android:id="@+id/txtMineMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lf_space_xxs"
                        android:textAppearance="@style/TextAppearance.LF.BodySmall" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_xl"
            android:layout_marginBottom="@dimen/lf_space_md"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.LF.TitleMedium"
            android:textColor="@color/lf_violet_600" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_sm"
            android:text="@string/matches_footer"
            android:textAppearance="@style/TextAppearance.LF.BodySmall" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
