<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/lf_screen_padding"
    android:layout_marginEnd="@dimen/lf_screen_padding"
    android:layout_marginBottom="@dimen/lf_space_md"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/lf_space_md">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPhoto"
            android:layout_width="@dimen/lf_thumb_card"
            android:layout_height="@dimen/lf_thumb_card"
            android:background="@color/lf_slate_200"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.LF.Medium"
            tools:src="@drawable/sample_iphone" />

        <TextView
            android:id="@+id/txtBadge"
            style="@style/Widget.LF.Badge.Lost"
            android:layout_marginStart="@dimen/lf_space_md"
            app:layout_constraintStart_toEndOf="@id/imgPhoto"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/badge_lost" />

        <TextView
            android:id="@+id/txtDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LF.Caption"
            app:layout_constraintBaseline_toBaselineOf="@id/txtBadge"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Hier" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lf_space_md"
            android:layout_marginTop="@dimen/lf_space_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.LF.TitleMedium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgPhoto"
            app:layout_constraintTop_toBottomOf="@id/txtBadge"
            tools:text="iPhone 13 noir" />

        <TextView
            android:id="@+id/txtMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lf_space_md"
            android:layout_marginTop="@dimen/lf_space_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.LF.BodySmall"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgPhoto"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            tools:text="Téléphones · Bibliothèque centrale" />

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lf_space_md"
            android:layout_marginTop="@dimen/lf_space_xxs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.LF.BodySmall"
            android:textColor="@color/lf_ink_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgPhoto"
            app:layout_constraintTop_toBottomOf="@id/txtMeta"
            tools:text="Coque transparente, écran légèrement fissuré." />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
