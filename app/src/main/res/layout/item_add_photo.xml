<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/lf_space_sm"
    android:paddingEnd="@dimen/lf_space_sm">

    <LinearLayout
        android:id="@+id/tile"
        android:layout_width="@dimen/lf_thumb_photo"
        android:layout_height="@dimen/lf_thumb_photo"
        android:background="@drawable/bg_add_photo_tile"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgAddIcon"
            android:layout_width="@dimen/lf_icon_md"
            android:layout_height="@dimen/lf_icon_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            app:tint="@color/lf_violet_600" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_xs"
            android:importantForAccessibility="no"
            android:text="@string/publish_add_photo"
            android:textAppearance="@style/TextAppearance.LF.LabelStrong"
            android:textColor="@color/lf_violet_600" />
    </LinearLayout>
</FrameLayout>
