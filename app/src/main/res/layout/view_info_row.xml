<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/lf_touch_target"
    android:orientation="horizontal"
    android:paddingTop="@dimen/lf_space_sm"
    android:paddingBottom="@dimen/lf_space_sm">

    <TextView
        android:id="@+id/txtInfoLabel"
        style="@style/Widget.LF.InfoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtInfoValue"
        style="@style/Widget.LF.InfoValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lf_space_lg"
        android:layout_weight="1" />
</LinearLayout>
