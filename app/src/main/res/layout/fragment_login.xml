<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/lf_space_xxl"
        android:paddingTop="@dimen/lf_space_huge"
        android:paddingEnd="@dimen/lf_space_xxl"
        android:paddingBottom="@dimen/lf_space_xxxl">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/lf_logo_size"
            android:layout_height="@dimen/lf_logo_size"
            android:contentDescription="@string/cd_logo"
            app:cardBackgroundColor="@color/lf_peach"
            app:cardCornerRadius="@dimen/lf_radius_logo"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/logo_initials"
                android:textAppearance="@style/TextAppearance.LF.Logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_md"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.LF.LabelStrong"
            android:textColor="@color/lf_peach" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_xxl"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/login_welcome"
            android:textAppearance="@style/TextAppearance.LF.Display"
            android:textColor="@color/lf_on_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_sm"
            android:gravity="center"
            android:text="@string/login_tagline"
            android:textAppearance="@style/TextAppearance.LF.Body"
            android:textColor="@color/lf_on_dark_muted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LF.Card.OnDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lf_space_xxl">

                <TextView
                    style="@style/Widget.LF.FieldLabel.OnDark"
                    android:layout_marginTop="0dp"
                    android:labelFor="@id/etEmail"
                    android:text="@string/label_university_email" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.LF.TextField.OnDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        style="@style/Widget.LF.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:hint="@string/hint_university_email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.LF.FieldLabel.OnDark"
                    android:labelFor="@id/etPassword"
                    android:text="@string/label_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.LF.TextField.OnDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        style="@style/Widget.LF.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:hint="@string/hint_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForgot"
                    style="@style/Widget.LF.Button.Text.OnDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/login_forgot" />

                <TextView
                    android:id="@+id/txtError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/lf_space_md"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/login_error_credentials"
                    android:textAppearance="@style/TextAppearance.LF.BodySmall"
                    android:textColor="@color/lf_error_on_dark"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.LF.Button.Peach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_submit" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                android:textAppearance="@style/TextAppearance.LF.BodySmall"
                android:textColor="@color/lf_on_dark_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Widget.LF.Button.Text.OnDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_create_account" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
