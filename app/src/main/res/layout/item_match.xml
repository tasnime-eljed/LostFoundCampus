<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lf_space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lf_space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgPhoto"
                android:layout_width="@dimen/lf_thumb_card"
                android:layout_height="@dimen/lf_thumb_card"
                android:background="@color/lf_slate_200"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.LF.Medium"
                tools:src="@drawable/sample_phone_found" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lf_space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtKind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LF.LabelStrong"
                    android:textColor="@color/lf_violet_600"
                    tools:text="Objet trouvé · Trouvé" />

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_space_xxs"
                    android:textAppearance="@style/TextAppearance.LF.TitleMedium"
                    tools:text="Smartphone noir, coque claire" />

                <TextView
                    android:id="@+id/txtMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_space_xxs"
                    android:textAppearance="@style/TextAppearance.LF.BodySmall"
                    tools:text="Bibliothèque centrale · 8 nov. 2026" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scoreRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_lg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.LF.LabelStrong"
                android:textColor="@color/lf_ink"
                tools:text="95 % de correspondance" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/matches_indication"
                android:textAppearance="@style/TextAppearance.LF.Label"
                android:textColor="@color/lf_ink_secondary" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressScore"
            style="@style/Widget.LF.MatchProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_sm"
            android:max="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnView"
                style="@style/Widget.LF.Button.Outlined.Soft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lf_space_sm"
                android:layout_weight="1"
                android:text="@string/matches_view" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/matches_contact" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
