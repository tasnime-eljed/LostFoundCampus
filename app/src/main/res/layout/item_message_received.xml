<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="@dimen/lf_screen_padding"
    android:paddingTop="@dimen/lf_space_xs"
    android:paddingEnd="@dimen/lf_space_huge"
    android:paddingBottom="@dimen/lf_space_xs">

    <TextView
        android:id="@+id/txtBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_received"
        android:maxWidth="@dimen/lf_bubble_max_width"
        android:paddingStart="@dimen/lf_space_lg"
        android:paddingTop="@dimen/lf_space_md"
        android:paddingEnd="@dimen/lf_space_lg"
        android:paddingBottom="@dimen/lf_space_md"
        android:textAppearance="@style/TextAppearance.LF.Body"
        android:textColor="@color/lf_ink"
        tools:text="Une coque transparente avec un petit autocollant bleu." />
</LinearLayout>
