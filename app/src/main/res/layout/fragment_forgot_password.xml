<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lf_space_xxl"
        android:paddingTop="@dimen/lf_space_xxl"
        android:paddingEnd="@dimen/lf_space_xxl"
        android:paddingBottom="@dimen/lf_space_xxxl">

        <include
            android:id="@+id/header"
            layout="@layout/layout_screen_header" />

        <!-- État saisie -->
        <LinearLayout
            android:id="@+id/groupForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lf_space_xxl"
                android:accessibilityHeading="true"
                android:text="@string/forgot_title"
                android:textAppearance="@style/TextAppearance.LF.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lf_space_xs"
                android:text="@string/forgot_subtitle"
                android:textAppearance="@style/TextAppearance.LF.Body"
                android:textColor="@color/lf_ink_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lf_space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lf_space_xl">

                    <TextView
                        style="@style/Widget.LF.FieldLabel"
                        android:layout_marginTop="0dp"
                        android:labelFor="@id/etEmail"
                        android:text="@string/label_university_email_required" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            style="@style/Widget.LF.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:hint="@string/hint_university_email"
                            android:imeOptions="actionDone"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lf_space_xl"
                        android:text="@string/forgot_submit" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Étape 2 : code reçu + nouveau mot de passe -->
        <LinearLayout
            android:id="@+id/groupCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lf_space_xxl"
                android:accessibilityHeading="true"
                android:text="@string/forgot_code_title"
                android:textAppearance="@style/TextAppearance.LF.Headline" />

            <TextView
                android:id="@+id/txtCodeBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lf_space_xs"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.LF.Body"
                android:textColor="@color/lf_ink_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lf_space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lf_space_xl">

                    <TextView
                        style="@style/Widget.LF.FieldLabel"
                        android:layout_marginTop="0dp"
                        android:labelFor="@id/etCode"
                        android:text="@string/label_code" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCode"
                            style="@style/Widget.LF.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="smsOTPCode"
                            android:hint="@string/hint_code"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="10" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Widget.LF.FieldLabel"
                        android:labelFor="@id/etNewPassword"
                        android:text="@string/label_new_password" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/helper_password_min"
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewPassword"
                            style="@style/Widget.LF.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:hint="@string/hint_new_password"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Widget.LF.FieldLabel"
                        android:labelFor="@id/etConfirmPassword"
                        android:text="@string/label_confirm_new_password" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            style="@style/Widget.LF.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:hint="@string/hint_confirm_password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lf_space_xl"
                        android:text="@string/forgot_reset_submit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResend"
                        style="@style/Widget.LF.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/lf_space_sm"
                        android:text="@string/forgot_resend" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
