<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-carte compacte (Publier, Détail) : gestes désactivés, toucher = ouvrir l'écran plein cadre. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMap"
    android:layout_width="match_parent"
    android:layout_height="@dimen/lf_mini_map_height"
    app:cardCornerRadius="@dimen/lf_radius_lg">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lf_sand" />

    <!-- Repli quand la carte ne peut pas s'afficher -->
    <LinearLayout
        android:id="@+id/fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lf_cream"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/lf_space_lg"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/lf_icon_md"
            android:layout_height="@dimen/lf_icon_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_map_off"
            app:tint="@color/lf_ink_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_xs"
            android:text="@string/map_unavailable"
            android:textAppearance="@style/TextAppearance.LF.LabelStrong" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/map_unavailable_body"
            android:textAppearance="@style/TextAppearance.LF.Caption" />
    </LinearLayout>

    <!-- Couche transparente : bloque les gestes de l'aperçu et ouvre l'écran plein cadre. -->
    <View
        android:id="@+id/touchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/cd_map_preview"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/labelBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/lf_space_sm"
        android:background="@drawable/bg_map_label"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:minHeight="@dimen/lf_touch_target"
        android:orientation="horizontal"
        android:paddingStart="@dimen/lf_space_md"
        android:paddingEnd="@dimen/lf_space_md">

        <ImageView
            android:layout_width="@dimen/lf_icon_sm"
            android:layout_height="@dimen/lf_icon_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_place"
            app:tint="@color/lf_violet_600" />

        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lf_space_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.LF.LabelStrong"
            android:textColor="@color/lf_ink"
            tools:text="Bibliothèque centrale" />

        <TextView
            android:id="@+id/txtAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lf_space_sm"
            android:text="@string/map_change"
            android:textAppearance="@style/TextAppearance.LF.LabelStrong"
            android:textColor="@color/lf_violet_600" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
