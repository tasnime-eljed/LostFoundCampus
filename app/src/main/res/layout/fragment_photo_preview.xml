<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_violet_900">

    <ImageView
        android:id="@+id/imgPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_preview_photo"
        android:scaleType="centerCrop"
        tools:src="@drawable/sample_phone_found" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/lf_space_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.LF.IconButton.BackOnPhoto"
            android:contentDescription="@string/cd_close"
            app:icon="@drawable/ic_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lf_space_md"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/lf_scrim"
            android:paddingStart="@dimen/lf_space_md"
            android:paddingTop="@dimen/lf_space_xs"
            android:paddingEnd="@dimen/lf_space_md"
            android:paddingBottom="@dimen/lf_space_xs"
            android:text="@string/preview_title"
            android:textAppearance="@style/TextAppearance.LF.LabelStrong"
            android:textColor="@color/lf_on_dark" />
    </LinearLayout>

    <!-- Panneau d'actions : fond assombri pour la lisibilité des boutons sur la photo -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/lf_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/lf_screen_padding"
        android:paddingTop="@dimen/lf_space_lg"
        android:paddingEnd="@dimen/lf_screen_padding"
        android:paddingBottom="@dimen/lf_space_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            style="@style/Widget.LF.Button.Peach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_analyze"
            app:icon="@drawable/ic_sparkle"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrop"
            style="@style/Widget.LF.Button.Outlined.OnDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_md"
            android:text="@string/preview_crop"
            app:icon="@drawable/ic_crop"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetake"
            style="@style/Widget.LF.Button.Outlined.OnDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_space_md"
            android:text="@string/preview_retake"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart" />
    </LinearLayout>
</FrameLayout>
