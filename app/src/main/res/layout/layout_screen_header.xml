<?xml version="1.0" encoding="utf-8"?>
<!-- En-tête commun : bouton retour carré + titre (maquettes Créer un compte, Publier, Correspondances). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/lf_touch_target"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.LF.IconButton.Back" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lf_space_md"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.LF.Title"
        tools:text="@string/publish_title" />
</LinearLayout>
