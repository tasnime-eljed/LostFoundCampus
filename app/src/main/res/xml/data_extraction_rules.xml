<?xml version="1.0" encoding="utf-8"?>
<!-- Les jetons de session ne sont ni sauvegardés ni transférés. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="supabase_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="supabase_session.xml" />
    </device-transfer>
</data-extraction-rules>
