<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Formes ===== -->
    <style name="ShapeAppearance.LF.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/lf_radius_sm</item>
    </style>
    <style name="ShapeAppearance.LF.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/lf_radius_md</item>
    </style>
    <style name="ShapeAppearance.LF.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/lf_radius_lg</item>
    </style>
    <style name="ShapeAppearance.LF.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.LF.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===== Boutons ===== -->
    <style name="Widget.LF.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/lf_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/lf_radius_md</item>
        <item name="backgroundTint">@color/lf_violet_600</item>
        <item name="android:textColor">@color/lf_white</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.Button</item>
        <item name="iconTint">@color/lf_white</item>
    </style>

    <style name="Widget.LF.Button.Peach">
        <item name="backgroundTint">@color/lf_peach</item>
        <item name="android:textColor">@color/lf_violet_900</item>
        <item name="iconTint">@color/lf_violet_900</item>
        <item name="rippleColor">@color/lf_violet_line</item>
    </style>

    <style name="Widget.LF.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/lf_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/lf_radius_md</item>
        <item name="strokeColor">@color/lf_violet_600</item>
        <item name="strokeWidth">@dimen/lf_stroke</item>
        <item name="backgroundTint">@color/lf_white</item>
        <item name="android:textColor">@color/lf_violet_600</item>
        <item name="iconTint">@color/lf_violet_600</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.Button</item>
    </style>

    <style name="Widget.LF.Button.Outlined.Soft">
        <item name="strokeColor">@color/lf_outline</item>
    </style>

    <style name="Widget.LF.Button.Outlined.Danger">
        <item name="strokeColor">@color/lf_error_border</item>
        <item name="android:textColor">@color/lf_error</item>
        <item name="iconTint">@color/lf_error</item>
    </style>

    <style name="Widget.LF.Button.Outlined.OnDark">
        <item name="strokeColor">@color/lf_on_dark</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/lf_on_dark</item>
        <item name="iconTint">@color/lf_on_dark</item>
    </style>

    <style name="Widget.LF.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/lf_touch_target</item>
        <item name="android:textColor">@color/lf_violet_600</item>
        <item name="iconTint">@color/lf_violet_600</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.LabelStrong</item>
        <item name="android:paddingStart">@dimen/lf_space_sm</item>
        <item name="android:paddingEnd">@dimen/lf_space_sm</item>
    </style>

    <style name="Widget.LF.Button.Text.OnDark">
        <item name="android:textColor">@color/lf_peach</item>
        <item name="iconTint">@color/lf_peach</item>
        <item name="rippleColor">@color/lf_violet_line</item>
    </style>

    <style name="Widget.LF.Button.Text.Danger">
        <item name="android:textColor">@color/lf_error</item>
        <item name="iconTint">@color/lf_error</item>
    </style>

    <!-- Bouton retour carré des en-têtes -->
    <style name="Widget.LF.IconButton.Back" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:layout_width">@dimen/lf_touch_target</item>
        <item name="android:layout_height">@dimen/lf_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/lf_radius_md</item>
        <item name="strokeColor">@color/lf_outline</item>
        <item name="strokeWidth">@dimen/lf_stroke</item>
        <item name="backgroundTint">@color/lf_white</item>
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconTint">@color/lf_ink</item>
        <item name="iconSize">@dimen/lf_icon_md</item>
        <item name="android:contentDescription">@string/cd_back</item>
    </style>

    <!-- Bouton retour rond, posé sur une photo -->
    <style name="Widget.LF.IconButton.BackOnPhoto" parent="Widget.LF.IconButton.Back">
        <item name="cornerRadius">@dimen/lf_radius_xl</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.LF.IconButton.Filled" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/lf_violet_600</item>
        <item name="iconTint">@color/lf_white</item>
        <item name="iconSize">@dimen/lf_icon_md</item>
    </style>

    <!-- ===== Champs de saisie ===== -->
    <style name="Widget.LF.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/lf_white</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">@dimen/lf_stroke</item>
        <item name="boxStrokeWidthFocused">@dimen/lf_stroke_focused</item>
        <item name="boxStrokeErrorColor">@color/lf_error_border</item>
        <item name="boxCornerRadiusTopStart">@dimen/lf_radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/lf_radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/lf_radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/lf_radius_md</item>
        <item name="errorTextColor">@color/lf_error</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/lf_ink_secondary</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.LF.Caption</item>
        <item name="errorTextAppearance">@style/TextAppearance.LF.Caption</item>
        <item name="endIconTint">@color/lf_ink_secondary</item>
        <item name="android:textColorHint">@color/lf_ink_secondary</item>
    </style>

    <!-- Variante sur fond sombre (connexion) : texte d'erreur éclairci pour rester lisible. -->
    <style name="Widget.LF.TextField.OnDark">
        <item name="errorTextColor">@color/lf_error_on_dark</item>
        <item name="boxStrokeColor">@color/field_stroke_on_dark</item>
    </style>

    <!-- Champ de message arrondi (conversation) -->
    <style name="Widget.LF.TextField.Pill">
        <item name="boxCornerRadiusTopStart">@dimen/lf_radius_bubble_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/lf_radius_bubble_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/lf_radius_bubble_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/lf_radius_bubble_input</item>
    </style>

    <style name="Widget.LF.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/lf_white</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">@dimen/lf_stroke</item>
        <item name="boxStrokeWidthFocused">@dimen/lf_stroke_focused</item>
        <item name="boxStrokeErrorColor">@color/lf_error_border</item>
        <item name="boxCornerRadiusTopStart">@dimen/lf_radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/lf_radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/lf_radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/lf_radius_md</item>
        <item name="errorTextColor">@color/lf_error</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/lf_ink_secondary</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.LF.Caption</item>
        <item name="errorTextAppearance">@style/TextAppearance.LF.Caption</item>
        <item name="endIconTint">@color/lf_ink</item>
        <item name="android:textColorHint">@color/lf_ink_secondary</item>
    </style>

    <style name="Widget.LF.EditText" parent="">
        <item name="android:textAppearance">@style/TextAppearance.LF.Body</item>
        <item name="android:textColor">@color/lf_ink</item>
        <item name="android:minHeight">@dimen/lf_button_height</item>
    </style>

    <!-- Libellé au-dessus d'un champ -->
    <style name="Widget.LF.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/lf_space_lg</item>
        <item name="android:layout_marginBottom">@dimen/lf_space_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.LabelStrong</item>
    </style>

    <style name="Widget.LF.FieldLabel.OnDark">
        <item name="android:textColor">@color/lf_on_dark</item>
    </style>

    <!-- ===== Cartes ===== -->
    <style name="Widget.LF.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/lf_white</item>
        <item name="strokeColor">@color/lf_outline_soft</item>
        <item name="strokeWidth">@dimen/lf_stroke</item>
        <item name="cardCornerRadius">@dimen/lf_radius_lg</item>
        <item name="cardElevation">@dimen/lf_card_elevation</item>
    </style>

    <style name="Widget.LF.Card.OnDark">
        <item name="cardBackgroundColor">@color/lf_violet_800</item>
        <item name="strokeColor">@color/lf_violet_line</item>
        <item name="cardCornerRadius">@dimen/lf_radius_xl</item>
    </style>

    <!-- ===== Puces de filtre ===== -->
    <style name="Widget.LF.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/lf_stroke</item>
        <item name="checkedIconVisible">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LF.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.Label</item>
    </style>

    <!-- Puce « Suggestion IA » / « Message suggéré par l'IA » -->
    <style name="Widget.LF.Chip.Ai" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/lf_pink_100</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/lf_pink_ink</item>
        <item name="chipIcon">@drawable/ic_sparkle</item>
        <item name="chipIconTint">@color/lf_pink_ink</item>
        <item name="chipIconVisible">true</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LF.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.Badge</item>
        <item name="closeIconTint">@color/lf_pink_ink</item>
    </style>

    <!-- ===== Badges ===== -->
    <style name="Widget.LF.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">@dimen/lf_badge_padding_h</item>
        <item name="android:paddingEnd">@dimen/lf_badge_padding_h</item>
        <item name="android:paddingTop">@dimen/lf_badge_padding_v</item>
        <item name="android:paddingBottom">@dimen/lf_badge_padding_v</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.Badge</item>
    </style>
    <style name="Widget.LF.Badge.Lost">
        <item name="android:backgroundTint">@color/lf_pink_100</item>
        <item name="android:textColor">@color/lf_pink_ink</item>
    </style>
    <style name="Widget.LF.Badge.Found">
        <item name="android:backgroundTint">@color/lf_peach</item>
        <item name="android:textColor">@color/lf_peach_ink</item>
    </style>
    <style name="Widget.LF.Badge.Returned">
        <item name="android:backgroundTint">@color/lf_returned_bg</item>
        <item name="android:textColor">@color/lf_returned_ink</item>
    </style>

    <!-- ===== Avatar à initiales ===== -->
    <style name="Widget.LF.Avatar" parent="">
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:backgroundTint">@color/lf_violet_600</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.LF.Avatar</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- ===== Onglets segmentés (Tous / Perdus / Trouvés) ===== -->
    <style name="Widget.LF.SegmentedTabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@drawable/bg_segmented_track</item>
        <item name="android:padding">@dimen/lf_space_xs</item>
        <item name="tabIndicator">@drawable/segmented_indicator</item>
        <item name="tabIndicatorColor">@color/lf_white</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorAnimationMode">linear</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabTextColor">@color/lf_ink_secondary</item>
        <item name="tabSelectedTextColor">@color/lf_violet_600</item>
        <item name="tabTextAppearance">@style/TextAppearance.LF.Tab</item>
        <item name="tabRippleColor">@color/lf_outline</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabPaddingStart">@dimen/lf_space_xs</item>
        <item name="tabPaddingEnd">@dimen/lf_space_xs</item>
    </style>

    <!-- Onglets de Publier : l'onglet actif est rose -->
    <style name="Widget.LF.SegmentedTabs.Publish">
        <item name="tabIndicatorColor">@color/lf_pink_100</item>
        <item name="tabSelectedTextColor">@color/lf_pink_ink</item>
    </style>

    <!-- Indicateur de position de la galerie (points) -->
    <style name="Widget.LF.DotsIndicator" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabBackground">@drawable/tab_dot</item>
        <item name="tabIndicatorHeight">0dp</item>
        <item name="tabGravity">center</item>
        <item name="tabMode">fixed</item>
        <item name="tabPaddingStart">@dimen/lf_space_xs</item>
        <item name="tabPaddingEnd">@dimen/lf_space_xs</item>
        <item name="tabMinWidth">@dimen/lf_space_lg</item>
        <item name="tabMaxWidth">@dimen/lf_space_lg</item>
        <item name="tabRippleColor">@null</item>
    </style>

    <!-- ===== Navigation basse ===== -->
    <style name="Widget.LF.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/lf_white</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LF.BottomNav.ActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.LF.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.LF.NavLabel</item>
    </style>

    <style name="Widget.LF.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/lf_pink_100</item>
    </style>

    <!-- ===== Divers ===== -->
    <style name="Widget.LF.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/lf_outline_soft</item>
        <item name="dividerThickness">@dimen/lf_stroke</item>
    </style>

    <style name="Widget.LF.MatchProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/lf_progress_track</item>
        <item name="trackCornerRadius">@dimen/lf_radius_sm</item>
        <item name="trackColor">@color/lf_sand</item>
        <item name="indicatorColor">@color/lf_violet_600</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <!-- Ligne « libellé : valeur » des cartes d'information -->
    <style name="Widget.LF.InfoLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.LF.Body</item>
        <item name="android:textColor">@color/lf_ink_secondary</item>
    </style>
    <style name="Widget.LF.InfoValue" parent="">
        <item name="android:textAppearance">@style/TextAppearance.LF.TitleMedium</item>
        <item name="android:gravity">end</item>
    </style>
</resources>
